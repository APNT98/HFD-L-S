---
// TRM Widget with live Datos Abiertos Colombia integration and Quick Currency Converter
---

<section class="section-padding trm-section-root" aria-label="Indicador Financiero TRM">
  <div class="container container-narrow">
    <div class="trm-card card reveal" role="region" aria-label="Tasa Representativa del Mercado">
      
      <!-- Card Header -->
      <div class="trm-header">
        <div class="trm-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="1" x2="12" y2="23"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
          <span>Indicador Financiero Oficial</span>
        </div>
        <h2 class="trm-title">Tasa Representativa del Mercado</h2>
        <p class="trm-subtitle">Superintendencia Financiera de Colombia (TRM)</p>
      </div>

      <!-- Live Rate Display -->
      <div class="trm-body" aria-live="polite" id="trm-live-area">
        <div class="trm-value-wrapper">
          <span id="trm-value" class="trm-value">
            <span class="loading-spinner"></span> Cargando...
          </span>
        </div>
        <div class="trm-meta">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Fecha de Vigencia: <strong id="trm-date">Actualizando...</strong></span>
        </div>
      </div>

      <!-- Interactive Quick Currency Converter (USD <-> COP) -->
      <div class="trm-converter">
        <h3 class="converter-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 10v12"></path>
            <path d="M17 14V2"></path>
            <path d="M21 6l-4-4-4 4"></path>
            <path d="M3 18l4 4 4-4"></path>
          </svg>
          Calculadora Rápida para Fletes (USD / COP)
        </h3>
        
        <div class="converter-inputs">
          <div class="converter-group">
            <label for="usd-input">Dólares (USD)</label>
            <div class="input-with-symbol">
              <span>$</span>
              <input type="number" id="usd-input" class="form-control" placeholder="100" min="0" step="any" />
            </div>
          </div>

          <div class="converter-equals">=</div>

          <div class="converter-group">
            <label for="cop-input">Pesos Colombianos (COP)</label>
            <div class="input-with-symbol">
              <span>$</span>
              <input type="text" id="cop-input" class="form-control" placeholder="Calculando..." readonly />
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Info -->
      <div class="trm-footer">
        <div class="source-info">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          <span>Sincronización automática con Datos Abiertos Colombia</span>
        </div>
        <button type="button" id="refresh-trm-btn" class="refresh-btn" title="Actualizar TRM ahora" aria-label="Actualizar TRM ahora">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
</section>

<style>
  .trm-section-root {
    background-color: var(--bg-body);
  }

  .trm-card {
    background: var(--bg-surface-elevated);
    border: 1.5px solid var(--border-color);
    padding: clamp(2rem, 4vw, 3rem);
    text-align: center;
    box-shadow: var(--shadow-xl);
  }

  .trm-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--primary-glow);
    color: var(--primary-color);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .trm-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 0.5rem;
  }

  .trm-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .trm-body {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .trm-value {
    font-size: clamp(2.2rem, 5vw, 3.25rem);
    font-weight: 800;
    color: var(--primary-color);
    line-height: 1.1;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .trm-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .trm-converter {
    background: var(--bg-surface);
    border: 1px dashed var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .converter-title {
    font-size: 1.05rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    color: var(--text-main);
  }

  .converter-inputs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .converter-group {
    flex: 1;
    min-width: 200px;
    text-align: left;
  }

  .converter-group label {
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
    display: block;
    color: var(--text-muted);
  }

  .input-with-symbol {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-with-symbol span {
    position: absolute;
    left: 1rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .input-with-symbol input {
    padding-left: 2rem;
  }

  .converter-equals {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--primary-color);
    padding-top: 1.25rem;
  }

  .trm-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--text-muted);
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
  }

  .source-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .refresh-btn {
    background: transparent;
    border: none;
    color: var(--primary-color);
    cursor: pointer;
    padding: 0.35rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast);
  }

  .refresh-btn:hover {
    transform: rotate(45deg);
  }

  .loading-spinner {
    width: 24px;
    height: 24px;
    border: 3px solid rgba(36, 150, 212, 0.3);
    border-radius: 50%;
    border-top-color: var(--primary-color);
    animation: spin 0.8s linear infinite;
    display: inline-block;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 600px) {
    .converter-inputs {
      flex-direction: column;
    }
    .converter-equals {
      padding-top: 0;
      transform: rotate(90deg);
    }
  }
</style>

<script>
  let currentTRMRate = 4150.00;

  async function fetchTRMData() {
    const valueEl = document.getElementById('trm-value');
    const dateEl = document.getElementById('trm-date');
    const usdInput = document.getElementById('usd-input') as HTMLInputElement | null;
    const copInput = document.getElementById('cop-input') as HTMLInputElement | null;

    if (!valueEl || !dateEl) return;

    try {
      const endpoint = 'https://www.datos.gov.co/resource/32sa-8pi3.json?$limit=1&$order=vigenciahasta%20DESC';
      const res = await fetch(endpoint);
      if (!res.ok) throw new Error('API error');
      const data = await res.json();

      if (data && data.length > 0) {
        const record = data[0];
        currentTRMRate = parseFloat(record.valor);

        const formatted = new Intl.NumberFormat('es-CO', {
          style: 'currency',
          currency: 'COP',
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(currentTRMRate);

        const rawDate = record.vigenciahasta || record.vigenciadesde;
        let dateStr = rawDate;
        if (rawDate) {
          const parts = rawDate.split('T')[0].split('-');
          if (parts.length === 3) {
            const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
            dateStr = d.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
          }
        }

        valueEl.textContent = `${formatted} COP`;
        dateEl.textContent = dateStr;
      }
    } catch (err) {
      valueEl.textContent = '$ 4.150,00 COP';
      dateEl.textContent = new Date().toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
    }

    // Update converter with initial 100 USD
    if (usdInput && copInput) {
      const calculate = () => {
        const val = parseFloat(usdInput.value) || 0;
        const totalCOP = val * currentTRMRate;
        copInput.value = new Intl.NumberFormat('es-CO', {
          style: 'currency',
          currency: 'COP',
          minimumFractionDigits: 0
        }).format(totalCOP);
      };

      if (!usdInput.value) usdInput.value = '100';
      calculate();

      usdInput.addEventListener('input', calculate);
    }
  }

  function setupTRMWidget() {
    fetchTRMData();
    const refreshBtn = document.getElementById('refresh-trm-btn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        const valueEl = document.getElementById('trm-value');
        if (valueEl) valueEl.innerHTML = '<span class="loading-spinner"></span> Actualizando...';
        fetchTRMData();
      });
    }
  }

  document.addEventListener('astro:page-load', setupTRMWidget);
</script>
