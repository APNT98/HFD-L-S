---
import { SITE_INFO } from '@utils/constants';

interface Props {
  breadcrumbs?: Array<{ name: string; item: string }>;
}

const { breadcrumbs = [] } = Astro.props;

const schemaOrganization = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Organization'],
  '@id': `${SITE_INFO.siteUrl}/#organization`,
  name: SITE_INFO.name,
  legalName: SITE_INFO.name,
  url: SITE_INFO.siteUrl,
  logo: `${SITE_INFO.siteUrl}/img/logo.png`,
  image: `${SITE_INFO.siteUrl}/img/hero.jpg`,
  description: SITE_INFO.description,
  telephone: SITE_INFO.phone,
  email: SITE_INFO.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE_INFO.address.street,
    addressLocality: SITE_INFO.address.city,
    addressCountry: 'CO'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE_INFO.address.geo.latitude,
    longitude: SITE_INFO.address.geo.longitude
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '08:00',
      closes: '12:00'
    }
  ],
  priceRange: '$$'
};

const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: crumb.item.startsWith('http') ? crumb.item : `${SITE_INFO.siteUrl}${crumb.item}`
  }))
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(schemaOrganization)} />
{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
